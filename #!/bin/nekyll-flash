def main():
print(f"""
{M}╔════════════════════════════════════════════════════════════════╗
║ 🧬 NEXUS DESIGNER PRO — ÉTAPE 2 ║
║ Forge des sites complets. Clone + analyse + redesign. ║
╚════════════════════════════════════════════════════════════════╝{N}
""")
info(f"Tools : {len(TOOLS)}")
info(f"Sites forgés: {len(STORE.sites)}")
info(f"Stockage : {SITES_DIR}")
print()
ok(f"Serveur : http://192.168.1.42:{PORT}/")
info(f"API tools : http://192.168.1.42:{PORT}/api/tools")
info(f"API sites : http://192.168.1.42:{PORT}/api/sites")
print()
warn("Ctrl+C pour arrêter")

try:
with Server((HOST, PORT), Handler) as srv:
srv.serve_forever()
except KeyboardInterrupt:
print("\n👋 Arrêté.")
except OSError as e:
no(f"Port {PORT} : {e}")


if __name__ == "__main__":
main()

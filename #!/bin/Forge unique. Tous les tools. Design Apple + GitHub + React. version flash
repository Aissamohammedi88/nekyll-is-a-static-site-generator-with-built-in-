print()
ok("Lance dans ton navigateur :")
print(f" {C}http://192.168.1.42:{PORT}/{N}")
print()
warn("Ctrl+C pour arrêter")

try:
with Server((HOST, PORT), Handler) as srv:
srv.serve_forever()
except KeyboardInterrupt:
print("\n👋 Arrêté.")
except OSError as e:
no(f"Port {PORT} : {e}")


if __name__ == "__main__":
main()

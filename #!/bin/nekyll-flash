--primaire: {primaire};
--accent: {accent};
--fond: #0a0014;
--card: #14001f;
--border: #2a1a3a;
--texte: #ffffff;
--muted: #888;
--radius: 16px;
--transition: cubic-bezier(0.4, 0, 0.2, 1);

h3 {{ font-size: 20px; margin: 24px 0 12px; animation: fadeUp 0.8s var(--transition) 0.2s both; }}

p {{ color: var(--muted); margin: 16px 0; animation: fadeUp 0.8s var(--transition) 0.3s both; }}

.card {{

# CLIENT SOCKS5 PUR PYTHON (sans dépendance)
# ═══════════════════════════════════════════════════════════════════
class Socks5:
@staticmethod
def connect(socks_host, socks_port, target_host, target_port, timeout=15):
try:
s = socket.create_connection((socks_host, socks_port), timeout=timeout)
s.settimeout(timeout)

# Handshake
s.sendall(b"\x05\x01\x00")
if s.recv(2) != b"\x05\x00":
s.close(); return None

# Requête
host_b = target_host.encode("utf-8")
req = b"\x05\x01\x00\x03" + bytes([len(host_b)]) + host_b + target_port.to_bytes(2, "big")
s.sendall(req)

# Réponse
rep = s.recv(4)
if rep[1] != 0x00:
s.close(); return None

if rep[3] == 0x01: s.recv(4)
elif rep[3] == 0x03:
l = s.recv(1)[0]; s.recv(l)
elif rep[3] == 0x04: s.recv(16)
s.recv(2)

return s
except Exception:
return None



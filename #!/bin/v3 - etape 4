""")


def main():
if len(sys.argv) < 2:
usage(); return
cmd = sys.argv[1]
args = sys.argv[2:]
if cmd not in COMMANDES:
no(f"Commande inconnue: {cmd}")
usage(); return
fn, _ = COMMANDES[cmd]
if cmd == "compare":
sect(f"compare {' '.join(args)}")
else:
sect(f"{cmd} {' '.join(args)}")
try:
if not args and cmd not in ("fetch",):
no("URL manquante"); return
fn(*args)
except Exception as e:
no(f"Erreur: {e}")


if __name__ == "__main__":
main()

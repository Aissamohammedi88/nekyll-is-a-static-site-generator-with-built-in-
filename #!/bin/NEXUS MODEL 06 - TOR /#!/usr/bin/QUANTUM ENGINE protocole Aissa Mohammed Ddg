# COULEURS TERMINAL
# ═══════════════════════════════════════════════════════════════════
V = '\033[92m'; J = '\033[93m'; R = '\033[91]'
B = '\033[94m'; C = '\033[96m'; M = '\033[95m'; N = '\033[0m'

def ok(m): print(f"{V}[OK]{N} {m}"); log.info(m)
def no(m): print(f"{R}[KO]{N} {m}"); log.error(m)

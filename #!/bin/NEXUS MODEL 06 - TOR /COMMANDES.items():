# ===== SCAN DE DOSSIER =====
def scanner_dossier(chemin):
exclusions = {".git", "node_modules", "__pycache__", ".venv", "venv",
"dist", "build", ".idea", ".vscode", "target", "vendor"}
fichiers = []
for root, dirs, files in os.walk(chemin):
dirs[:] = [d for d in dirs if d not in exclusions]
for f in files:
if f.startswith('.'):
continue
ext = Path(f).suffix.lower()
if ext in EXTENSIONS:
p = Path(root) / f
try:
contenu = p.read_text(encoding="utf-8", errors="ignore")
fichiers.append({
"chemin": str(p.relative_to(chemin)),
"nom": f,
"ext": ext,
"langage": EXTENSIONS[ext],
"contenu": contenu,
"lignes": contenu.count("\n") + 1,
"octets": p.stat().st_size,
})
except Exception as e:
pass
return fichiers


# ===== MÉTRIQUES DE COMPLEXITÉ =====
def complexite_cyclomatique(code, langage):
"""Complexité cyclomatique de McCabe."""
compteurs = {
"python": [r"\bif\b", r"\belif\b", r"\bfor\b", r"\bwhile\b", r"\bexcept\b", r"\band\b", r"\bor\b", r"\bcase\b"],
"javascript": [r"\bif\b", r"\belse if\b", r"\bfor\b", r"\bwhile\b", r"\bcase\b", r"&&", r"\|\|", r"\?.*:"],
"typescript": [r"\bif\b", r"\belse if\b", r"\bfor\b", r"\bwhile\b", r"\bcase\b", r"&&", r"\|\|"],
"java": [r"\bif\b", r"\belse if\b", r"\bfor\b", r"\bwhile\b", r"\bcase\b", r"&&", r"\|\|"],
"go": [r"\bif\b", r"\bfor\b", r"\bcase\b", r"&&", r"\|\|"],
"rust": [r"\bif\b", r"\bmatch\b", r"\bfor\b", r"\bwhile\b", r"&&", r"\|\|"],
"c": [r"\bif\b", r"\belse if\b", r"\bfor\b", r"\bwhile\b", r"\bcase\b", r"&&", r"\|\|"],
"cpp": [r"\bif\b", r"\belse if\b", r"\bfor\b", r"\bwhile\b", r"\bcase\b", r"&&", r"\|\|"],
}
patterns = compteurs.get(langage, [r"\bif\b", r"\bfor\b", r"\bwhile\b"])
count = 1
for p in patterns:
count += len(re.findall(p, code))
return count


def halstead_metrics(code):
"""Métriques de Halstead (vocabulaire, longueur, volume)."""
operateurs = re.findall(r'[+\-*/%<>=!&|^~?:]', code)
operandes = re.findall(r'\b\w+\b', code)
n1 = len(set(operateurs))
n2 = len(set(operandes))
N1 = len(operateurs)
N2 = len(operandes)
n = n1 + n2
N = N1 + N2
volume = N * math.log2(n) if n > 0 else 0
return {
"n1": n1, "n2": n2, "N1": N1, "N2": N2,
"vocabulaire": n, "longueur": N,
"volume": round(volume, 2),
}


def lignes_de_code(code):
"""Compte les lignes : total, code, commentaires, vides."""
lignes = code.split("\n")
total = len(lignes)
vides = sum(1 for l in lignes if not l.strip())
commentaires = 0
in_block_comment = False
for l in lignes:
s = l.strip()
if '"""' in s or "'''" in s:
commentaires += 1
continue
if s.startswith("#") or s.startswith("//") or s.startswith("*"):
commentaires += 1
code_lignes = total - vides - commentaires
ratio = (commentaires / total * 100) if total > 0 else 0
return {
"total": total, "vides": vides,
"commentaires": commentaires, "code": code_lignes,
"ratio_commentaires": round(ratio, 2),
}


def index_maintenabilite(volume, complexite, lignes, commentaires_pct):
"""Indice de maintenabilité (0-100, plus haut = mieux)."""
if lignes == 0:
return 100
try:
mi = 171 - 5.2 * math.log(volume + 1) - 0.23 * complexite - 16.2 * math.log(lignes + 1) + 50 * math.sin(math.sqrt(2.4 * commentaires_pct / 100))
return round(max(0, min(100, mi * 100 / 171)), 2)
except (ValueError, ZeroDivisionError):
return 0


# ===== DÉTECTION CODE MORT =====
def detecter_code_mort(fichiers):
"""Détecte fonctions non appelées, imports inutilisés."""
resultats = []

for f in fichiers:
if f["langage"] != "python":
continue
code = f["contenu"]
try:
tree = ast.parse(code)
except SyntaxError:
continue

# Fonctions définies
fonctions = [n.name for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))]
classes = [n.name for n in ast.walk(tree) if isinstance(n, ast.ClassDef)]
imports = []
for n in ast.walk(tree):
if isinstance(n, ast.Import):
for a in n.names:
imports.append(a.asname or a.name)
elif isinstance(n, ast.ImportFrom):
for a in n.names:
imports.append(a.asname or a.name)

# Compte les usages
usages = Counter()
for n in ast.walk(tree):
if isinstance(n, ast.Name):
usages[n.id] += 1
elif isinstance(n, ast.Attribute):
usages[n.attr] += 1

# Imports non utilisés
imports_inutiles = [i for i in imports if usages.get(i, 0) <= 1]

# Fonctions jamais appelées
fonctions_mortes = []
for fn in fonctions:
if fn.startswith("_") or fn in ("main", "__init__"):
continue
if usages.get(fn, 0) == 0:
fonctions_mortes.append(fn)

if imports_inutiles or fonctions_mortes:
resultats.append({
"fichier": f["chemin"],
"imports_inutiles": imports_inutiles,
"fonctions_mortes": fonctions_mortes,
})

return resultats


# ===== ANALYSE =====
def analyser_fichier(f):
code = f["contenu"]
lignes = lignes_de_code(code)
complexite = complexite_cyclomatique(code, f["langage"])
halstead = halstead_metrics(code)
mi = index_maintenabilite(halstead["volume"], complexite, lignes["code"], lignes["ratio_commentaires"])
return {
"chemin": f["chemin"],
"nom": f["nom"],
"langage": f["langage"],
"lignes": lignes,
"complexite": complexite,
"halstead": halstead,
"maintenabilite": mi,
}


def analyser_dossier(chemin):
fichiers = scanner_dossier(chemin)
if not fichiers:
warn("Aucun fichier détecté"); return None

analyses = []
with ThreadPoolExecutor(max_workers=8) as ex:
futures = [ex.submit(analyser_fichier, f) for f in fichiers]
for fu in as_completed(futures):
analyses.append(fu.result())

# Global
total_lignes = sum(a["lignes"]["total"] for a in analyses)
total_code = sum(a["lignes"]["code"] for a in analyses)
total_commentaires = sum(a["lignes"]["commentaires"] for a in analyses)
complexite_totale = sum(a["complexite"] for a in analyses)
mi_moyen = sum(a["maintenabilite"] for a in analyses) / len(analyses) if analyses else 0

langages = Counter(a["langage"] for a in analyses)

return {
"chemin": str(chemin),
"date": datetime.now().isoformat(),
"total_fichiers": len(analyses),
"langages": dict(langages),
"total_lignes": total_lignes,
"total_code": total_code,
"total_commentaires": total_commentaires,
"complexite_totale": complexite_totale,
"maintenabilite_moyenne": round(mi_moyen, 2),
"fichiers": analyses,
}



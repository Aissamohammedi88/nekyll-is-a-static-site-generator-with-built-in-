<script>
async function chargerSites() {
const r = await fetch('/api/sites');
const sites = await r.json();
document.getElementById('nb-sites').textContent = sites.length;
const grid = document.getElementById('sites-grid');
grid.innerHTML = '';
sites.forEach(s => {
const a = document.createElement('a');
a.className = 'site';
a.href = '/site/' + s.id + '/';
a.target = '_blank';
a.innerHTML = `
<h3>${s.nom}</h3>
<div class="meta">${s.date || ''}</div>
<div class="source">${s.url_source || 'config locale'}</div>
<div class="actions">
<button onclick="event.preventDefault(); event.stopPropagation(); window.open('/site/${s.id}/', '_blank')">Ouvrir</button>
<button onclick="event.preventDefault(); event.stopPropagation(); supprimer('${s.id}')">Supprimer</button>
</div>
`;
grid.appendChild(a);
});
}

async function chargerTools() {
const r = await fetch('/api/tools');
const tools = await r.json();
document.getElementById('nb-tools').textContent = Object.keys(tools).length;
const list = document.getElementById('tools-list');
list.innerHTML = '';
Object.entries(tools).forEach(([nom, desc]) => {
const d = document.createElement('div');
d.className = 'tool';
d.innerHTML = `<div class="name">${nom}</div><div class="desc">${desc}</div>`;
list.appendChild(d);
});
}

async function forgerURL() {
const url = document.getElementById('url-input').value.trim();
if (!url) return alert('Colle une URL');
const nom = prompt('Nom du site :', 'Site ' + new Date().toLocaleTimeString());
if (!nom) return;
const btn = document.querySelector('.form button');
btn.textContent = 'Forge...';
btn.disabled = true;
try {
const r = await fetch('/api/forge', {
method: 'POST',
headers: {'Content-Type':'application/json'},
body: JSON.stringify({url: url, nom: nom})
});
const data = await r.json();
if (data.erreur) {
alert('Erreur : ' + data.erreur);
} else {
alert('✅ Site forgé : ' + data.id);
chargerSites();
}
} catch (e) {
alert('Erreur : ' + e.message);
} finally {
btn.textContent = 'Forger';
btn.disabled = false;
}
}

async function supprimer(id) {
if (!confirm('Supprimer ce site ?')) return;
await fetch('/api/site/' + id, {method: 'DELETE'});
chargerSites();
}

chargerSites();
chargerTools();
</script>
</body>
</html>"""


class Handler(http.server.BaseHTTPRequestHandler):
def do_GET(self):
path = self.path.split("?")[0]

if path == "/" or path == "/index.html":
self._html(INDEX_HTML)
elif path == "/api/sites":
self._json([{
"id": s["id"], "nom": s["nom"],
"url_source": s.get("url_source", ""),
"date": s.get("date", "")
} for s in STORE.lister()])
elif path == "/api/tools":
self._json({k: v["desc"] for k, v in TOOLS.items()})
elif path.startswith("/site/"):
sid = path[6:].rstrip("/")
site_dir = SITES_DIR / sid
if site_dir.exists():
fichier = site_dir / "index.html"
if fichier.exists():
self._html(fichier.read_text(encoding="utf-8"))
else:
self._404()
else:
self._404()
elif path.startswith("/site/") and path.endswith(".css"):
sid = path.split("/")[2]
fichier = SITES_DIR / sid / "style.css"
if fichier.exists():
self._file(fichier, "text/css")
else:
self._404()
else:
self._404()

def do_POST(self):
if self.path == "/api/forge":
length = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(length).decode()
try:
data = json.loads(body)
except Exception:
self._json({"erreur": "JSON invalide"}); return

url = data.get("url")
nom = data.get("nom", "Site")

if not url:
self._json({"erreur": "URL manquante"}); return

sid = hashlib.md5((url + str(time.time())).encode()).hexdigest()[:12]

try:
gen = SiteGenerator(sid, nom, url_source=url)
resultat = gen.forger_depuis_url()

if "erreur" in resultat:
self._json({"erreur": resultat["erreur"]}); return

STORE.add({
"id": sid, "nom": nom, "url_source": url,
"date": datetime.now().strftime("%Y-%m-%d %H:%M"),
"ts": time.time()
})
self._json({"id": sid, "status": "ok"})
except Exception as e:
self._json({"erreur": str(e)})
else:
self._404()

def do_DELETE(self):
if self.path.startswith("/api/site/"):
sid = self.path.split("/")[-1]
STORE.delete(sid)
self._json({"status": "ok"})
else:
self._404()

def _html(self, content):
self.send_response(200)
self.send_header("Content-Type", "text/html; charset=utf-8")
self.end_headers()
self.wfile.write(content.encode("utf-8"))

def _json(self, data):
self.send_response(200)
self.send_header("Content-Type", "application/json")
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(json.dumps(data, indent=2, ensure_ascii=False).encode())

def _file(self, path, content_type):
try:
self.send_response(200)
self.send_header("Content-Type", content_type)
self.end_headers()
self.wfile.write(path.read_bytes())
except Exception:
self._404()

def _404(self):
self.send_response(404); self.end_headers()
self.wfile.write(b"404")

def log_message(self, *a): pass


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
daemon_threads = True
allow_reuse_address = True


# ═══════════════════════════════════════════════════════════════════

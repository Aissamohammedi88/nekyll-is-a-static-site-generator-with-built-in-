# ROTATEUR D'IDENTITÉ
# ═══════════════════════════════════════════════════════════════════
class Rotateur:
def __init__(self):
self.ua = random.choice(CONFIG["user_agents"])
self.last_rot = time.time()
self.count = 0
self.historique = []

def rotate(self):
self.ua = random.choice(CONFIG["user_agents"])
self.last_rot = time.time()
self.count += 1
self.historique.append({
"count": self.count,
"time": datetime.now().isoformat(),
"ua": self.ua[:50]
})
if len(self.historique) > 100:
self.historique = self.historique[-100:]

def check(self):
if time.time() - self.last_rot > CONFIG["rotation_seconds"]:
self.rotate()

def headers(self):
self.check()
h = {"User-Agent": self.ua}
h.update(CONFIG["obfuscation"])
return h


# ═══════════════════════════════════════════════════════════════════
# STATS
# ═══════════════════════════════════════════════════════════════════
class Stats:
def __init__(self):
self.lock = threading.Lock()
self.data = {
"requetes": 0,
"succes": 0,
"echecs": 0,
"octets": 0,
"debut": time.time(),
}

def inc(self, key, n=1):
with self.lock:
self.data[key] = self.data.get(key, 0) + n

def get(self):
with self.lock:
d = dict(self.data)
d["uptime_secondes"] = int(time.time() - d["debut"])
return d


# ═══════════════════════════════════════════════════════════════════
# CLIENT NEXUS ORB
# ═══════════════════════════════════════════════════════════════════
class NexusOrb:
def __init__(self, use_tor=True):
self.use_tor = use_tor
self.rotateur = Rotateur()
self.stats = Stats()
self.killswitch_actif = False

def check_tor(self):
"""Vérifie si Tor/Orbot est disponible."""
try:
s = socket.create_connection((CONFIG["socks_host"], CONFIG["socks_port"]), timeout=3)
s.close()
return True
except Exception:
return False

def _connect(self, host, port, https=False):
if self.use_tor:
s = Socks5.connect(CONFIG["socks_host"], CONFIG["socks_port"], host, port)
if s is None:
if self.killswitch_actif:
raise Exception("KILL SWITCH — Tor indisponible")
return None
else:
try:
s = socket.create_connection((host, port), timeout=15)
except Exception:
return None

if https:
import ssl
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
try:
s = ctx.wrap_socket(s, server_hostname=host)
except Exception:
s.close(); return None
return s

def get(self, url, timeout=20):
self.stats.inc("requetes")
from urllib.parse import urlparse
p = urlparse(url)
host = p.hostname
port = p.port or (443 if p.scheme == "https" else 80)
path = p.path or "/"
if p.query: path += "?" + p.query

if not host:
self.stats.inc("echecs"); return {"ok": False, "erreur": "URL invalide"}

try:
s = self._connect(host, port, https=(p.scheme == "https"))
except Exception as e:
self.stats.inc("echecs")
return {"ok": False, "erreur": str(e)}

if s is None:
self.stats.inc("echecs")
return {"ok": False, "erreur": "Connexion échouée (Tor down ?)"}

h = self.rotateur.headers()
h["Host"] = host

req = f"GET {path} HTTP/1.1\r\n"
for k, v in h.items():
req += f"{k}: {v}\r\n"
req += "\r\n"

try:
s.sendall(req.encode())
data = b""
while True:
chunk = s.recv(32768)
if not chunk: break
data += chunk
s.close()

self.stats.inc("succes")
self.stats.inc("octets", len(data))

code = 0
try:
code = int(data.split(b"\r\n", 1)[0].split(b" ")[1])
except Exception:
pass

return {"ok": True, "code": code, "taille": len(data), "data": data}
except Exception as e:
self.stats.inc("echecs")
try: s.close()
except: pass
return {"ok": False, "erreur": str(e)[:80]}

def killswitch(self, state=True):
"""Active/désactive le kill switch."""
self.killswitch_actif = state
if state:
warn("KILL SWITCH ACTIVÉ — aucune requête ne passera si Tor tombe")
else:
info("Kill switch désactivé")



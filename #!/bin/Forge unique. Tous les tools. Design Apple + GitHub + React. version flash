class Handler(http.server.BaseHTTPRequestHandler):
def do_GET(self):
if self.path == "/" or self.path == "/index.html":
tools_json = json.dumps({k: (v.__doc__ or "").strip().split("\n")[0] for k, v in TOOLS.items()})
html = INDEX_HTML.replace("__TOOLS_JSON__", tools_json)
self.send_response(200)
self.send_header("Content-Type", "text/html; charset=utf-8")
self.end_headers()
self.wfile.write(html.encode("utf-8"))
elif self.path == "/api/tools":
self._json({k: (v.__doc__ or "").strip() for k, v in TOOLS.items()})
elif self.path.startswith("/api/"):
tool_name = self.path[5:].split("?")[0]
if tool_name in TOOLS:
try:
resultat = TOOLS[tool_name]("http://example.com") if tool_name in ["download_html", "analyze_html", "extract_colors", "extract_fonts", "extract_animations", "detect_framework", "analyze_responsive", "extract_texts", "page_metadata"] else "OK"
self._json({"tool": tool_name, "status": "ok", "resultat": str(resultat)[:500]})
except Exception as e:
self._json({"tool": tool_name, "erreur": str(e)})
else:
self._json({"erreur": "tool inconnu"})
else:
self.send_response(404); self.end_headers()

def _json(self, data):
self.send_response(200)
self.send_header("Content-Type", "application/json")
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(json.dumps(data, indent=2, ensure_ascii=False).encode())

def log_message(self, *a): pass


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
daemon_threads = True
allow_reuse_address = True



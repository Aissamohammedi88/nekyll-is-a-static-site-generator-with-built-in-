#!/usr/bin/env python3# -*- coding: utf-8 -*-
"""
🧬 NEXUS DESIGNER PRO — ÉTAPE 2
Forge des sites complets. Clone + analyse + redesign + génère.
Ouvre le port direct. Voir les sites forger.

Usage :
python3 nexus_designer_pro.py
"""
import os, sys, ssl, re, json, time, socket, hashlib, secrets, shutil
import urllib.request, urllib.error
import http.server, socketserver, threading
from urllib.parse import urlparse, urljoin, quote, unquote
from datetime import datetime
from pathlib import Path

PORT = 9003
HOST = "0.0.0.0"
OUTPUT = Path.home() / "Documents" / "nexus_designer_pro"
OUTPUT.mkdir(parents=True, exist_ok=True)
SITES_DIR = OUTPUT / "sites"
SITES_DIR.mkdir(parents=True, exist_ok=True)

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

HEADERS = {
'User-Agent': 'Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15',
'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
'Accept-Language': 'en-US,en;q=0.9,fr;q=0.8',
}

V = '\033[92m'; J = '\033[93m'; R = '\033[91]'; B = '\033[94m'; C = '\033[96m'; M = '\033[95m'; N = '\033[0m'
def ok(m): print(f"{V}✅{N} {m}")
def no(m): print(f"{R}❌{N} {m}")
def warn(m): print(f"{J}⚠️ {N} {m}")
def info(m): print(f"{B}ℹ️ {N} {m}")
def sect(m): print(f"\n{C}{'═'*64}{N}\n{C} {m}{N}\n{C}{'═'*64}{N}\n")


# ═══════════════════════════════════════════════════════════════════
# STOCKAGE
# ═══════════════════════════════════════════════════════════════════
class Store:
"""Stockage des sites générés."""
def __init__(self):
self.lock = threading.Lock()
self.sites = {}
self.charger()

def charger(self):
idx = OUTPUT / "index.json"
if idx.exists():
try:
self.sites = json.loads(idx.read_text())
except Exception:
self.sites = {}

def sauver(self):
with self.lock:
(OUTPUT / "index.json").write_text(json.dumps(self.sites, indent=2, ensure_ascii=False))

def add(self, site):
with self.lock:
self.sites[site["id"]] = site
self.sauver()

def get(self, sid):
return self.sites.get(sid)

def delete(self, sid):
with self.lock:
if sid in self.sites:
shutil.rmtree(SITES_DIR / sid, ignore_errors=True)
del self.sites[sid]
self.sauver()

def lister(self):
return sorted(self.sites.values(), key=lambda s: -s.get("ts", 0))

STORE = Store()


# ═══════════════════════════════════════════════════════════════════
# TOOLS
# ═══════════════════════════════════════════════════════════════════
TOOLS = {}

def tool(nom, desc):
def wrapper(fn):
TOOLS[nom] = {"fn": fn, "desc": desc}
return fn
return wrapper


@tool("fetch", "Télécharge une page HTML")
def t_fetch(url):
req = urllib.request.Request(url, headers=HEADERS)
with urllib.request.urlopen(req, timeout=20, context=ctx) as r:
return r.read().decode('utf-8', errors='ignore'), r.geturl()


@tool("extract_css", "Extrait tout le CSS d'une page")
def t_extract_css(html, base):
css = []
for m in re.findall(r'<link[^>]+href=["\']([^"\']+\.css[^"\']*)', html, re.I):
css.append(urljoin(base, m))
inline = re.findall(r'<style[^>]*>(.*?)</style>', html, re.I | re.S)
return {"externes": css, "inline": inline}


@tool("extract_js", "Extrait tout le JS d'une page")
def t_extract_js(html, base):
js = []
for m in re.findall(r'<script[^>]+src=["\']([^"\']+)', html, re.I):
js.append(urljoin(base, m))
inline = re.findall(r'<script(?![^>]*src)[^>]*>(.*?)</script>', html, re.I | re.S)
return {"externes": js, "inline": inline}


@tool("extract_images", "Extrait les images d'une page")
def t_extract_images(html, base):
imgs = []
for m in re.findall(r'<img[^>]+src=["\']([^"\']+)', html, re.I):
imgs.append(urljoin(base, m))
for m in re.findall(r'url\(["\']?([^"\')]+\.(jpg|jpeg|png|gif|webp|svg))', html, re.I):
imgs.append(urljoin(base, m[0]))
return list(set(imgs))[:50]


@tool("extract_styles", "Extrait styles inline + scripts")
def t_extract_styles(html):
styles = re.findall(r'<style[^>]*>(.*?)</style>', html, re.I | re.S)
return {"nb_styles": len(styles), "styles": styles}


@tool("clean_html", "Nettoie le HTML (retire scripts trackers)")
def t_clean_html(html):
html = re.sub(r'<script[^>]*>.*?</script>', '', html, flags=re.I | re.S)
html = re.sub(r'<iframe[^>]*>.*?</iframe>', '', html, flags=re.I | re.S)
html = re.sub(r'on\w+="[^"]*"', '', html, flags=re.I)
return html


@tool("extract_meta", "Extrait les meta tags")
def t_extract_meta(html):
metas = {}
for m in re.finditer(r'<meta[^>]+>', html, re.I):
tag = m.group(0)
n = re.search(r'name=["\']([^"\']+)', tag, re.I)
p = re.search(r'property=["\']([^"\']+)', tag, re.I)
c = re.search(r'content=["\']([^"\']*)', tag, re.I)
key = (n.group(1) if n else (p.group(1) if p else None))
if key and c:
metas[key] = c.group(1)
return metas


@tool("extract_headings", "Extrait tous les titres h1-h6")
def t_extract_headings(html):
out = {}
for i in range(1, 7):
tags = re.findall(rf'<h{i}[^>]*>(.*?)</h{i}>', html, re.I | re.S)
out[f"h{i}"] = [re.sub(r'<[^>]+>', '', t).strip()[:100] for t in tags][:20]
return out


@tool("extract_links", "Extrait tous les liens")
def t_extract_links(html, base):
links = []
for m in re.findall(r'<a[^>]+href=["\']([^"\']+)', html, re.I):
links.append(urljoin(base, m))
return list(set(links))[:100]


@tool("extract_colors", "Extrait les couleurs")
def t_extract_colors(html):
colors = set()
for c in re.findall(r'#[0-9a-fA-F]{3,8}\b', html):
colors.add(c.lower())
for c in re.findall(r'rgba?\([^)]+\)', html):
colors.add(c)
return sorted(colors)[:80]


@tool("extract_fonts", "Extrait les polices")
def t_extract_fonts(html):
fonts = set()
for f in re.findall(r'font-family:\s*([^;}\n]+)', html, re.I):
fonts.add(f.strip()[:80])
return sorted(fonts)[:30]


@tool("extract_animations", "Détecte animations CSS")
def t_extract_animations(html):
return {
"keyframes": len(re.findall(r'@keyframes', html, re.I)),
"transitions": len(re.findall(r'transition:', html, re.I)),
"transforms": len(re.findall(r'transform:', html, re.I)),
"cubic_bezier": len(re.findall(r'cubic-bezier', html, re.I)),
}


@tool("detect_framework", "Détecte le framework")
def t_detect_framework(html):
fw = []
checks = {"React": ["_react", "react-dom", "__REACT"], "Vue": ["data-v-", "__vue__"], "Angular": ["ng-version"], "Svelte": ["svelte-"], "Next.js": ["__next"], "Nuxt": ["__nuxt"], "Astro": ["data-astro"], "Tailwind": ["tailwind"], "Bootstrap": ["bootstrap"]}
for nom, signes in checks.items():
for s in signes:
if s.lower() in html.lower():
fw.append(nom); break
return fw


# ═══════════════════════════════════════════════════════════════════
# GÉNÉRATEUR DE SITE
# ═══════════════════════════════════════════════════════════════════
class SiteGenerator:
"""Génère un site complet à partir d'une URL ou d'une config."""

def __init__(self, sid, nom, url_source=None, theme="nexus"):
self.sid = sid
self.nom = nom
self.url_source = url_source
self.theme = theme
self.dir = SITES_DIR / sid
self.dir.mkdir(parents=True, exist_ok=True)
self.data = {}

def forger_depuis_url(self):
"""Clone, analyse et forger un site depuis une URL."""
info(f"Forge depuis : {self.url_source}")
try:
html, final = t_fetch(self.url_source)
except Exception as e:
return {"erreur": str(e)}

self.data = {
"url_finale": final,
"meta": t_extract_meta(html),
"headings": t_extract_headings(html),
"links": t_extract_links(html, final),
"colors": t_extract_colors(html),
"fonts": t_extract_fonts(html),
"animations": t_extract_animations(html),
"framework": t_detect_framework(html),
"css": t_extract_css(html, final),
"js": t_extract_js(html, final),
"images": t_extract_images(html, final),
"html_brut": html[:50000]
}

# Génère le site
self._generer_site()
return self.data

def forger_depuis_config(self, config):
"""Forge un site à partir d'une config JSON."""
self.data = {"config": config}
self._generer_site_config(config)
return self.data

def _generer_site(self):
"""Génère les fichiers du site."""
# CSS principal
css = self._generer_css()
(self.dir / "style.css").write_text(css, encoding="utf-8")

# HTML principal
html = self._generer_html()
(self.dir / "index.html").write_text(html, encoding="utf-8")

# JS
js = self._generer_js()
(self.dir / "app.js").write_text(js, encoding="utf-8")

# JSON data
data = {k: v for k, v in self.data.items() if k != "html_brut"}
(self.dir / "data.json").write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")

def _generer_site_config(self, config):
"""Génère un site depuis une config."""
css = f"""
:root {{
--primaire: {config.get('couleur', '#c8a45c')};
--fond: {config.get('fond', '#0a0014')};
--texte: {config.get('texte', '#ffffff')};
}}
body {{ font-family: -apple-system, system-ui; background: var(--fond); color: var(--texte); margin: 0; padding: 40px; }}
h1 {{ font-size: 64px; color: var(--primaire); letter-spacing: -2px; }}
.card {{ background: rgba(200,164,92,0.1); border: 1px solid var(--primaire); border-radius: 16px; padding: 24px; margin: 16px 0; }}
"""
(self.dir / "style.css").write_text(css, encoding="utf-8")
html = f"""<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><title>{config.get('nom', 'Nexus')}</title><link rel="stylesheet" href="style.css"></head>
<body>
<h1>{config.get('nom', 'Nexus')}</h1>
<div class="card">{config.get('description', 'Forgé par Nexus Designer Pro')}</div>
</body>
</html>"""
(self.dir / "index.html").write_text(html, encoding="utf-8")

def _generer_css(self):
"""Génère le CSS inspiré du site source."""
couleurs = self.data.get("colors", [])
primaire = couleurs[0] if couleurs else "#c8a45c"
accent = couleurs[1] if len(couleurs) > 1 else "#ff6ec7"
return f"""
/* 🧬 NEXUS DESIGNER PRO — CSS généré */

# ===== FETCH INTELLIGENT =====
def fetch(url, timeout=15, follow=True):
"""Fetch avec suivi de redirections, capture de la chaîne complète."""
chaine = []
courant = url
for _ in range(10 if follow else 1):
try:
req = urllib.request.Request(courant, headers=HEADERS)
with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
html = r.read().decode('utf-8', errors='ignore')
final = r.geturl()
code = r.status
chaine.append({"url": courant, "code": code, "final": final})
if final == courant:
return html, final, chaine
courant = final
except urllib.error.HTTPError as e:
chaine.append({"url": courant, "code": e.code, "erreur": "http"})
return None, courant, chaine
except Exception as e:
chaine.append({"url": courant, "code": 0, "erreur": str(e)[:60]})
return None, courant, chaine
return None, courant, chaine


# ===== EXTRACTION DE LIENS =====
def extraire_liens(html, base_url):
liens = []
for m in re.findall(r'<a[^>]+href=["\']([^"\']+)', html, re.I):
if m.startswith('#') or m.startswith('javascript:') or m.startswith('mailto:'):
continue
liens.append(urljoin(base_url, m))
return list(dict.fromkeys(liens)) # dédup


def extraire_ressources(html, base_url):
ressources = {"css": [], "js": [], "img": [], "fonts": [], "video": []}
for m in re.findall(r'<link[^>]+href=["\']([^"\']+\.css[^"\']*)', html, re.I):
ressources["css"].append(urljoin(base_url, m))
for m in re.findall(r'<script[^>]+src=["\']([^"\']+)', html, re.I):
ressources["js"].append(urljoin(base_url, m))
for m in re.findall(r'<img[^>]+src=["\']([^"\']+)', html, re.I):
ressources["img"].append(urljoin(base_url, m))
for m in re.findall(r'url\(["\']?([^"\')]+\.(woff2?|ttf|otf))', html, re.I):
ressources["fonts"].append(urljoin(base_url, m[0]))
for m in re.findall(r'<video[^>]+src=["\']([^"\']+)', html, re.I):
ressources["video"].append(urljoin(base_url, m))
for k in ressources:
ressources[k] = list(dict.fromkeys(ressources[k]))
return ressources


# ===== CRAWLER DE PROFONDEUR =====
def crawler(url_depart, profondeur=2, max_pages=50):
"""Crawler BFS jusqu'à N profondeur, construire le graphe."""
visites = set()
graphe = defaultdict(set)
file = deque([(url_depart, 0)])
pages = {}

while file and len(visites) < max_pages:
url, niveau = file.popleft()
if url in visites or niveau > profondeur:
continue
visites.add(url)

html, final, chaine = fetch(url, timeout=8)
if not html:
continue

titre = ""
m = re.search(r'<title[^>]*>(.*?)</title>', html, re.I | re.S)
if m: titre = m.group(1).strip()[:100]

pages[url] = {
"titre": titre,
"niveau": niveau,
"taille": len(html),
"redirections": chaine,
}

liens = extraire_liens(html, final)
for lien in liens:
graphe[url].add(lien)
if lien not in visites and niveau + 1 <= profondeur:
file.append((lien, niveau + 1))

return {
"url_depart": url_depart,
"profondeur_max": profondeur,
"pages_visitees": len(visites),
"graphe": {k: list(v) for k, v in graphe.items()},
"pages": pages,
}


# ===== SUIVI DE REDIRECTIONS =====
def suivre_redirections(url):
"""Trace TOUTE la chaîne de redirections."""
chaine = []
courant = url
for i in range(15):
try:
req = urllib.request.Request(courant, headers=HEADERS)
with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
chaine.append({
"etape": i + 1,
"url": courant,
"code": r.status,
"final": r.geturl(),
})
if r.geturl() == courant:
break
courant = r.geturl()
except urllib.error.HTTPError as e:
chaine.append({"etape": i + 1, "url": courant, "code": e.code})
break
except Exception as e:
chaine.append({"etape": i + 1, "url": courant, "erreur": str(e)[:60]})
break
return chaine


# ===== EXTRACTION DE PARAMÈTRES =====
def extraire_parametres(url):
p = urlparse(url)
params = parse_qs(p.query)
return {
"url": url,
"scheme": p.scheme,
"host": p.hostname,
"port": p.port,
"path": p.path,
"params": {k: v for k, v in params.items()},
"fragment": p.fragment,
}


# ===== EXTRACTION D'URLS DANS UN TEXTE =====
def extraire_urls_texte(texte):
pattern = r'https?://[^\s<>"\'\)\]]+'
return list(dict.fromkeys(re.findall(pattern, texte)))


# ===== CARTE DE DOMAINES =====
def carte_domaines(urls):
domaines = defaultdict(int)
sous_domaines = defaultdict(set)
for u in urls:
try:
p = urlparse(u)
if p.hostname:
domaines[p.hostname] += 1
parts = p.hostname.split('.')
if len(parts) > 2:
sous_domaines['.'.join(parts[-2:])].add(p.hostname)
except Exception:
pass
return {
"domaines": dict(sorted(domaines.items(), key=lambda x: -x[1])[:50]),
"sous_domaines": {k: list(v) for k, v in sous_domaines.items()},
}


# ===== FETCH PARALLÈLE =====
def fetch_parallele(urls, max_workers=20):
"""Fetch plusieurs URLs en parallèle."""
resultats = {}
def fetch_one(u):
html, final, chaine = fetch(u, timeout=8)
return u, {"ok": html is not None, "taille": len(html) if html else 0,
"final": final, "chaine": chaine}
with ThreadPoolExecutor(max_workers=max_workers) as ex:
futures = [ex.submit(fetch_one, u) for u in urls]
for f in as_completed(futures):
u, r = f.result()
resultats[u] = r
return resultats



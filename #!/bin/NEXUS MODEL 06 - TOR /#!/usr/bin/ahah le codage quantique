def usage():
print(f"""
{C}NEXUS MODEL 09 - STATIC FORGE (mieux que Jekyll){N}
Chemin: {BASE}/modele_09.py
Port: AUCUN (CLI) — port ouvert à l'étape 10 seulement

Usage: python3 modele_09.py <commande> [args]

Commandes:
new <site> - Crée un nouveau site
build <site> - Génère HTML/CSS/JS
preview <site> [port] - Build + serveur local
compete - Score vs Google/Jekyll/Hugo
langs - Liste les 20 langages

Exemples:
python3 modele_09.py new "Mon Portfolio"
python3 modele_09.py build "Mon Portfolio"
python3 modele_09.py preview "Mon Portfolio" 9009
python3 modele_09.py compete
python3 modele_09.py langs
""")

def main():
if len(sys.argv) < 2:
usage(); return
cmd = sys.argv[1]
args = sys.argv[2:]
try:
if cmd == "new":
cmd_new(args[0] if args else "nexus-site")
elif cmd == "build":
cmd_build(args[0] if args else "nexus-site")
elif cmd == "preview":
nom = args[0] if args else "nexus-site"
port = int(args[1]) if len(args) > 1 else PORT_DEFAULT
cmd_preview(nom, port)
elif cmd == "compete":
cmd_compete()
elif cmd == "langs":
cmd_langs()
else:
usage()
except Exception as e:
no(f"Erreur : {e}")
import traceback
traceback.print_exc()

if name == "main":
try:
main()
except KeyboardInterrupt:
print("\n👋 Interrompu")

```


# ===== SOCKS5 PUR =====
class Socks5:
@staticmethod
def connect(socks_host, socks_port, target_host, target_port, timeout=15):
try:
s = socket.create_connection((socks_host, socks_port), timeout=timeout)
s.settimeout(timeout)

# Handshake
s.sendall(b"\x05\x01\x00")
rep = s.recv(2)
if rep != b"\x05\x00":
s.close(); return None

# Requête
host_b = target_host.encode("utf-8")
req = b"\x05\x01\x00\x03" + bytes([len(host_b)]) + host_b + target_port.to_bytes(2, "big")
s.sendall(req)

# Réponse
rep = s.recv(4)
if rep[1] != 0x00:
s.close(); return None

# Skip l'adresse retour
if rep[3] == 0x01:
s.recv(4)
elif rep[3] == 0x03:
l = s.recv(1)[0]
s.recv(l)
elif rep[3] == 0x04:
s.recv(16)
s.recv(2)

return s
except Exception:
return None


# ===== ROTATEUR =====
class Rotateur:
def __init__(self):
self.ua = random.choice(USER_AGENTS)
self.last_rot = time.time()
self.count = 0
self.historique = []

def rotate(self):
self.ua = random.choice(USER_AGENTS)
self.last_rot = time.time()
self.count += 1
self.historique.append({
"n": self.count,
"time": datetime.now().isoformat(),
"ua": self.ua[:60],
})
if len(self.historique) > 50:
self.historique = self.historique[-50:]

def headers(self):
h = {"User-Agent": self.ua}
h.update(OBFUSCATION_HEADERS)
return h


# ===== CLIENT =====
class ClientAnon:
def __init__(self, use_tor=True):
self.use_tor = use_tor
self.rotateur = Rotateur()
self.stats = {"requetes": 0, "succes": 0, "echecs": 0, "octets": 0}

def check_tor(self):
try:
s = socket.create_connection((SOCKS_HOST, SOCKS_PORT), timeout=3)
s.close()
return True
except Exception:
return False

def _connect(self, host, port, https=False):
if self.use_tor:
s = Socks5.connect(SOCKS_HOST, SOCKS_PORT, host, port)
if s is None:
return None
else:
try:
s = socket.create_connection((host, port), timeout=15)
except Exception:
return None
if https:
c = ssl.create_default_context()
c.check_hostname = False
c.verify_mode = ssl.CERT_NONE
try:
s = c.wrap_socket(s, server_hostname=host)
except Exception:
s.close(); return None
return s

def get(self, url, timeout=20):
self.stats["requetes"] += 1
p = urlparse(url)
host = p.hostname
port = p.port or (443 if p.scheme == "https" else 80)
path = p.path or "/"
if p.query:
path += "?" + p.query

if not host:
self.stats["echecs"] += 1
return {"ok": False, "erreur": "URL invalide"}

s = self._connect(host, port, https=(p.scheme == "https"))
if s is None:
self.stats["echecs"] += 1
return {"ok": False, "erreur": "Connexion échouée (Tor down ?)"}

h = self.rotateur.headers()
h["Host"] = host
h["Connection"] = "close"

req = f"GET {path} HTTP/1.1\r\n"
for k, v in h.items():
req += f"{k}: {v}\r\n"
req += "\r\n"

try:
s.sendall(req.encode())
data = b""
while True:
chunk = s.recv(32768)
if not chunk:
break
data += chunk
s.close()

self.stats["succes"] += 1
self.stats["octets"] += len(data)

code = 0
try:
code = int(data.split(b"\r\n", 1)[0].split(b" ")[1])
except Exception:
pass

return {"ok": True, "code": code, "taille": len(data), "data": data}
except Exception as e:
self.stats["echecs"] += 1
try: s.close()
except: pass
return {"ok": False, "erreur": str(e)[:100]}

def get_body(self, url):
r = self.get(url)
if not r["ok"]:
return r
try:
body = r["data"].split(b"\r\n\r\n", 1)[1]
try:
text = body.decode("utf-8", errors="ignore")
except Exception:
text = str(body[:2000])
return {"ok": True, "code": r["code"], "text": text}
except Exception as e:
return {"ok": False, "erreur": str(e)}



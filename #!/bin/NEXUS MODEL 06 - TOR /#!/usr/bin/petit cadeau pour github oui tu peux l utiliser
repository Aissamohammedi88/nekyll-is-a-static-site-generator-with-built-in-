# ================================================================
# PARSEUR MARKDOWN (maison, 200 lignes)
# ================================================================
class MarkdownParser:
def __init__(self):
self.code_blocks = []

def parse(self, text: str) -> str:
# Protège les blocs de code
text = re.sub(r"```(\w*)\n(.*?)```", self._sauver_code, text, flags=re.DOTALL)

# Titres
for i in range(6, 0, -1):
text = re.sub(rf"^{'#' * i} (.+)$", rf"<h{i}>\1</h{i}>", text, flags=re.MULTILINE)

# Gras / italique
text = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", text)
text = re.sub(r"\*(.+?)\*", r"<em>\1</em>", text)

# Code inline
text = re.sub(r"`([^`\n]+)`", r"<code>\1</code>", text)

# Liens / images
text = re.sub(r"!\[([^\]]*)\]\(([^)]+)\)", r'<img src="\2" alt="\1">', text)
text = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', text)

# Listes
text = self._listes(text)

# Paragraphes
text = self._paragraphes(text)

# Restaure les blocs de code
for i, html_code in enumerate(self.code_blocks):
text = text.replace(f"__CODEBLOCK_{i}__", html_code)

return text

def _sauver_code(self, m):
lang = m.group(1) or "text"
code = m.group(2).rstrip()
idx = len(self.code_blocks)
self.code_blocks.append(self._highlight(code, lang))
return f"__CODEBLOCK_{idx}__"

def _highlight(self, code: str, lang: str) -> str:
esc = html.escape(code)
if lang not in LANGAGES:
return f'<pre class="code"><code>{esc}</code></pre>'
return f'<pre class="code" data-lang="{lang}"><code>{esc}</code></pre>'

def _listes(self, text: str) -> str:
lignes = text.split("\n")
out, in_ul, in_ol = [], False, False
for l in lignes:
if re.match(r"^[-*] ", l):
if not in_ul:
if in_ol: out.append("</ol>"); in_ol = False
out.append("<ul>"); in_ul = True
out.append(f"<li>{l[2:]}</li>")
elif re.match(r"^\d+\. ", l):
if not in_ol:
if in_ul: out.append("</ul>"); in_ul = False
out.append("<ol>"); in_ol = True
out.append(f"<li>{re.sub(r'^\d+\. ', '', l)}</li>")
else:
if in_ul: out.append("</ul>"); in_ul = False
if in_ol: out.append("</ol>"); in_ol = False
out.append(l)
if in_ul: out.append("</ul>")
if in_ol: out.append("</ol>")
return "\n".join(out)

def _paragraphes(self, text: str) -> str:
paras = []
for bloc in text.split("\n\n"):
bloc = bloc.strip()
if not bloc: continue
if bloc.startswith("<") and not bloc.startswith("<a "):
paras.append(bloc)
else:
paras.append(f"<p>{bloc}</p>")
return "\n".join(paras)


# ================================================================
# GÉNÉRATEUR
# ================================================================
class StaticForge:
def __init__(self, nom_site: str):
self.nom = nom_site
self.dir = SITES_DIR / re.sub(r"[^a-zA-Z0-9_-]", "_", nom_site)[:50]
self.dir.mkdir(parents=True, exist_ok=True)
self.src = self.dir / "src"
self.out = self.dir / "public"
self.src.mkdir(exist_ok=True)
self.out.mkdir(exist_ok=True)
self.md = MarkdownParser()

def creer_structure(self):
"""Crée la structure de base."""
(self.src / "index.md").write_text(f"""# {self.nom}

Généré par NEXUS Static Forge — mieux que Jekyll.

## Fonctionnalités

- 20 langages dont Objective-C (1984), Perl (1987), Simula (1962)
- Coloration syntaxique maison
- Vitesse parallèle
- Multimodal (texte + code)

## Exemple Python


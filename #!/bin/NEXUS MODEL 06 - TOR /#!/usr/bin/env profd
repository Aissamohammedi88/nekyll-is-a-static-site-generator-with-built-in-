COMMANDES = {
"bell": (cmd_bell, "bell - État de Bell"),
"ghz": (cmd_ghz, "ghz [n] - État GHZ à N qubits"),
"grover": (cmd_grover, "grover <cible> [n] - Recherche de Grover"),
"qaoa": (cmd_qaoa, "qaoa [n] - QAOA sur N qubits"),
"competition": (cmd_competition, "competition - Guerre d'enchères"),
"deeplink": (cmd_deeplink, "deeplink <url> - Deep linking"),
"golink": (cmd_golink, "golink <url> - GOLINK : fetch profond"),
"score": (cmd_score, "score - Score du projet"),
"protocole": (cmd_protocole, "protocole - Affiche le protocole"),
}


def usage():
print(f"""
{C}NEXUS MODEL 09 - QUANTUM ENGINE + PROTOCOLE COMPÉTITION{N}
Chemin: {BASE}/modele_09.py
Port: AUCUN (CLI)

Usage: python3 modele_09.py <commande> [args]

Commandes:
""")
for nom, (_, desc) in COMMANDES.items():
print(f" {nom.ljust(14)} {desc}")
print(f"""
Exemples:
python3 modele_09.py bell
python3 modele_09.py ghz 5
python3 modele_09.py grover 7 4
python3 modele_09.py qaoa 6
python3 modele_09.py competition
python3 modele_09.py protocole
python3 modele_09.py score
python3 modele_09.py deeplink https://example.com
""")


def main():
if len(sys.argv) < 2:
usage(); return
cmd = sys.argv[1]
args = sys.argv[2:]
if cmd not in COMMANDES:
no(f"Commande inconnue: {cmd}")
usage(); return
fn, _ = COMMANDES[cmd]
sect(f"{cmd} {' '.join(args)[:60]}")
try:
if cmd == "grover":
cible = args[0] if args else "7"
n = int(args[1]) if len(args) > 1 else 4
fn(cible, n)
elif cmd == "ghz":
n = int(args[0]) if args else 3
fn(n)
elif cmd == "qaoa":
n = int(args[0]) if args else 4
fn(n)
elif cmd in ("deeplink", "golink"):
fn(*args) if args else fn()
else:
fn()
except Exception as e:
no(f"Erreur: {e}")


if __name__ == "__main__":
main()

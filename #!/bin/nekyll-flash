def _generer_html(self):
"""Génère le HTML final."""
meta = self.data.get("meta", {})
title = meta.get("og:title") or meta.get("title") or self.nom
desc = meta.get("description") or meta.get("og:description") or "Forgé par Nexus Designer Pro"
headings = self.data.get("headings", {})
h1s = headings.get("h1", [])
h2s = headings.get("h2", [])

cards = ""
for h in h2s[:6]:
cards += f'<div class="card"><h3>{h}</h3><p>Section forgée par Nexus Designer Pro</p></div>'

return f"""<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content="{desc}">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header>
<div class="logo">NEXUS<span>.</span></div>
<div class="pulse" style="color: var(--muted); font-size: 12px;">Forgé automatiquement</div>
</header>

<main>
<h1>{h1s[0] if h1s else self.nom}</h1>
<p>{desc}</p>

<div style="display:flex; gap:20px; margin: 32px 0;">
<a href="#" class="btn">Voir</a>
<a href="#" class="btn" style="background:transparent; border:1px solid var(--primaire); color:var(--primaire);">Explorer</a>
</div>

<div class="grid">
<div class="stat"><span class="num">{len(self.data.get('links', []))}</span><span class="lbl">Liens</span></div>
<div class="stat"><span class="num">{len(self.data.get('colors', []))}</span><span class="lbl">Couleurs</span></div>
<div class="stat"><span class="num">{len(self.data.get('fonts', []))}</span><span class="lbl">Polices</span></div>
<div class="stat"><span class="num">{self.data.get('animations', {}).get('keyframes', 0)}</span><span class="lbl">Animations</span></div>
</div>

<h2>Sections</h2>
{cards if cards else '<div class="card"><h3>Aucune section détectée</h3><p>Le site a été forgé à partir de la page source.</p></div>'}

<h2>Analyse</h2>
<div class="card">
<h3>Framework détecté</h3>
<p>{', '.join(self.data.get('framework', [])) or 'Aucun'}</p>
</div>
<div class="card">
<h3>Couleurs extraites</h3>
<p>{', '.join(self.data.get('colors', [])[:10]) or 'Aucune'}</p>
</div>
<div class="card">
<h3>Polices</h3>
<p>{', '.join(self.data.get('fonts', [])[:5]) or 'Aucune'}</p>
</div>
</main>

<footer>
🧬 Forgé par NEXUS DESIGNER PRO — CreWos Sybot
<br>Source : {self.url_source or "config locale"}
<br>{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
</footer>

<script src="app.js"></script>
</body>
</html>"""

def _generer_js(self):
"""Génère le JS du site."""
return """// 🧬 NEXUS DESIGNER PRO — JS généré
// Animations cinétiques au scroll

document.querySelectorAll('.card').forEach((el, i) => {
el.style.animationDelay = (i * 0.1) + 's';
});

// Parallaxe léger sur les stat
window.addEventListener('scroll', () => {
const y = window.scrollY;
document.querySelectorAll('.stat .num').forEach(el => {
el.style.transform = `translateY(${y * 0.05}px)`;
});
});

// Compteur animé
document.querySelectorAll('.stat .num').forEach(el => {
const cible = parseInt(el.textContent) || 0;
let actuel = 0;
const step = cible / 30;
const timer = setInterval(() => {
actuel += step;
if (actuel >= cible) { actuel = cible; clearInterval(timer); }
el.textContent = Math.floor(actuel);
}, 30);
});

console.log('🧬 Nexus Designer Pro — Site forgé');
"""



# ═══════════════════════════════════════════════════════════════════
# HANDLER HTTP
# ═══════════════════════════════════════════════════════════════════
class Handler(http.server.BaseHTTPRequestHandler):
def do_GET(self):
path = self.path.split("?")[0]
if path == "/" or path == "/index.html":
tools_info = {k: v["desc"] for k, v in TOOLS.items()}
html = INDEX_HTML.replace("__TOOLS_INFO__", json.dumps(tools_info, ensure_ascii=False))
self._html(html)
elif path == "/api/tools":
self._json({k: v["desc"] for k, v in TOOLS.items()})
elif path == "/api/ping":
self._json({"status": "ok", "port": PORT, "tools": len(TOOLS)})
else:
self._404()

def do_POST(self):
path = self.path.split("?")[0]
if path.startswith("/api/tool/"):
nom = path[10:]
if nom not in TOOLS:
self._json({"erreur": "tool inconnu"}); return
try:
length = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(length).decode() if length else "{}"
data = json.loads(body)
args = data.get("args", [])
fn = TOOLS[nom]["fn"]
try:
resultat = fn(*args)
except TypeError as e:
resultat = {"erreur": f"Arguments invalides : {e}"}
self._json(resultat)
except Exception as e:
self._json({"erreur": str(e)})
else:
self._404()

def _html(self, content):
self.send_response(200)
self.send_header("Content-Type", "text/html; charset=utf-8")
self.end_headers()
self.wfile.write(content.encode("utf-8"))

def _json(self, data):
self.send_response(200)
self.send_header("Content-Type", "application/json")
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(json.dumps(data, indent=2, ensure_ascii=False).encode())

def _404(self):
self.send_response(404); self.end_headers()
self.wfile.write(b"404")

def log_message(self, *a): pass


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
daemon_threads = True
allow_reuse_address = True


# ═══════════════════════════════════════════════════════════════════

def cmd_bell():
"""État de Bell : |00> + |11> / √2."""
sect("ÉTAT DE BELL")
c = QuantumCircuit(2)
c.h(0)
c.cnot(0, 1)
p = c.probabilites()
for i in range(4):
bits = format(i, "02b")
bar = "█" * int(p[i] * 40)
print(f" |{bits}> {p[i]:.4f} {bar}")
ok("État de Bell créé : (|00> + |11>) / √2")

def cmd_ghz(n=3):
"""État GHZ à N qubits."""
sect(f"ÉTAT GHZ À {n} QUBITS")
c = QuantumCircuit(n)
c.h(0)
for i in range(1, n):
c.cnot(0, i)
p = c.probabilites()
for i in range(2 ** n):
if p[i] > 0.001:
bits = format(i, f"0{n}b")
print(f" |{bits}> {p[i]:.4f}")
ok(f"État GHZ à {n} qubits créé")

def cmd_grover(cible, n=4):
"""Recherche de Grover."""
sect(f"GROVER : cible={cible} sur {n} qubits")
cible = int(cible)
def oracle(circuit, n):
# Oracle : marque la cible
bits = format(cible, f"0{n}b")
for i, b in enumerate(reversed(bits)):
if b == "0":
circuit.x(i)
QuantumGates.CZ(circuit.state, 0, n - 1)
for i, b in enumerate(reversed(bits)):
if b == "0":
circuit.x(i)

circuit = grover(oracle, n)
p = circuit.probabilites()
top = sorted(range(len(p)), key=lambda i: -p[i])[:5]
info(f"Top 5 résultats :")
for i in top:
bits = format(i, f"0{n}b")
bar = "█" * int(p[i] * 40)
print(f" |{bits}> {p[i]:.4f} {bar}")
ok(f"Solution trouvée : {format(top[0], f'0{n}b')}")

def cmd_qaoa(n=4):
"""QAOA simplifié."""
sect(f"QAOA : {n} qubits")
circuit = qaoa(n, gamma=0.5, beta=0.3)
p = circuit.probabilites()
top = sorted(range(len(p)), key=lambda i: -p[i])[:5]
for i in top:
bits = format(i, f"0{n}b")
print(f" |{bits}> {p[i]:.4f}")
ok(f"QAOA exécuté sur {n} qubits")

def cmd_competition():
"""Simule la compétition GOBLINK vs GOLINK."""
p = ProtocoleCompetition()
p.calculer_attractivite()
return p.simuler_guerre()

def cmd_deeplink(url):
"""Deep linking : fetch + crawl + analyse."""
sect(f"DEEPLINK : {url}")
import urllib.request, ssl
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
try:
req = urllib.request.Request(url, headers={"User-Agent": "Nexus/1.0"})
with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
html = r.read().decode("utf-8", errors="ignore")
ok(f"Taille: {len(html):,} caractères")
liens = list(set(__import__("re").findall(r'href=["\']([^"\']+)', html)))[:20]
info(f"{len(liens)} liens trouvés (échantillon):")
for l in liens[:10]:
print(f" {l[:80]}")
except Exception as e:
no(f"Erreur: {e}")

def cmd_golink(url):
"""GOLINK : fetch intelligent + analyse profonde."""
cmd_deeplink(url)

def cmd_score():
"""Score du projet."""
p = ProtocoleCompetition()
score = p.calculer_attractivite()
sect("SCORE DU PROJET NEXUS")
info(f"Attractivité stratégique : {score}/100")
if score >= 90:
ok("Projet ULTRA stratégique — Microsoft et Google vont se battre")
elif score >= 70:
ok("Projet TRÈS stratégique — intérêt majeur")
elif score >= 50:
warn("Projet stratégique — intérêt modéré")
else:
no("Projet peu stratégique")


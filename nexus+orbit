# PROXY LOCAL
# ═══════════════════════════════════════════════════════════════════
class ProxyOrb:
def __init__(self, port, use_tor=True):
self.port = port
self.client = NexusOrb(use_tor=use_tor)
self.client.killswitch(True)

def demarrer(self):
import http.server
import socketserver

client = self.client

class Handler(http.server.BaseHTTPRequestHandler):
def do_GET(self):
url = self.path
if not url.startswith("http"):
url = "http://" + url
r = client.get(url)
if r["ok"]:
self.send_response(r["code"] or 200)
self.end_headers()
try: self.wfile.write(r["data"])
except Exception: pass
else:
self.send_response(502)
self.end_headers()
self.wfile.write(f"Orb: {r.get('erreur','?')}".encode())

def log_message(self, *a): pass

class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
daemon_threads = True
allow_reuse_address = True

info(f"Proxy sur http://127.0.0.1:{self.port}")
info("Configure ton navigateur avec ce proxy")
try:
with Server(("127.0.0.1", self.port), Handler) as srv:
srv.serve_forever()
except KeyboardInterrupt:
print("\n👋 Arrêté.")



"""
🧬 NEXUS DESIGNER — CreWos Sybot
Forge unique. Tous les tools. Design Apple + GitHub + React.
Ouvre le port direct. Voir les tools.

Usage :
python3 nexus_designer.py
"""
import os, sys, ssl, re, json, time, socket, hashlib, secrets
import urllib.request, urllib.error
import http.server, socketserver, threading
from urllib.parse import urlparse, quote
from datetime import datetime
from pathlib import Path

# ═══════════════════════════════════════════════════════════════════
# CONFIG
# ═══════════════════════════════════════════════════════════════════
PORT = 9002
HOST = "0.0.0.0"
OUTPUT = Path.home() / "Documents" / "nexus_designer"
OUTPUT.mkdir(parents=True, exist_ok=True)

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

HEADERS = {
'User-Agent': 'Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15',
'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
'Accept-Language': 'en-US,en;q=0.9,fr;q=0.8',
}

V = '\033[92m'; J = '\033[93m'; R = '\033[91]'; B = '\033[94m'; C = '\033[96m'; M = '\033[95m'; N = '\033[0m'
def ok(m): print(f"{V}✅{N} {m}")
def no(m): print(f"{R}❌{N} {m}")
def warn(m): print(f"{J}⚠️ {N} {m}")
def info(m): print(f"{B}ℹ️ {N} {m}")
def sect(m): print(f"\n{C}{'═'*64}{N}\n{C} {m}{N}\n{C}{'═'*64}{N}\n")


# ═══════════════════════════════════════════════════════════════════
# TOOLS — 20 outils dans une seule forge
# ═══════════════════════════════════════════════════════════════════
TOOLS = {}

def tool(nom):
"""Décorateur pour enregistrer un tool."""
def wrapper(fn):
TOOLS[nom] = fn
return fn
return wrapper


# ─── TOOL 1 : Télécharger HTML ───
@tool("download_html")
def download_html(url):
"""Télécharge une page HTML et renvoie (html, url_finale)."""
req = urllib.request.Request(url, headers=HEADERS)
try:
with urllib.request.urlopen(req, timeout=20, context=ctx) as r:
return r.read().decode('utf-8', errors='ignore'), r.geturl()
except Exception as e:
return None, str(e)


# ─── TOOL 2 : Analyser HTML ───
@tool("analyze_html")
def analyze_html(html):
"""Analyse une page HTML et extrait les métadonnées."""
if not html:
return {}
t = re.search(r'<title[^>]*>(.*?)</title>', html, re.I | re.S)
title = t.group(1).strip() if t else "Sans titre"
desc = re.search(r'<meta[^>]*name=["\']description["\'][^>]*content=["\']([^"\']+)', html, re.I)
desc = desc.group(1) if desc else ""
return {
"title": title,
"description": desc,
"taille_html": len(html),
"nb_scripts": len(re.findall(r'<script', html, re.I)),
"nb_styles": len(re.findall(r'<link[^>]*stylesheet', html, re.I)),
"nb_images": len(re.findall(r'<img', html, re.I)),
"nb_links": len(re.findall(r'<a\s', html, re.I)),
}


# ─── TOOL 3 : Extraire les couleurs ───
@tool("extract_colors")
def extract_colors(html):
"""Extrait toutes les couleurs CSS d'une page."""
if not html:
return []
colors = set()
# Hex
for c in re.findall(r'#[0-9a-fA-F]{3,8}\b', html):
colors.add(c.lower())
# rgb/rgba
for c in re.findall(r'rgba?\([^)]+\)', html):
colors.add(c)
return sorted(colors)[:50]


# ─── TOOL 4 : Extraire les fonts ───
@tool("extract_fonts")
def extract_fonts(html):
"""Extrait les polices utilisées."""
if not html:
return []
fonts = set()
for f in re.findall(r'font-family:\s*([^;}\n]+)', html, re.I):
fonts.add(f.strip()[:80])
for f in re.findall(r'fonts\.googleapis\.com/css2\?family=([^:"\']+)', html):
fonts.add(f.replace("+", " "))
return sorted(fonts)[:30]


# ─── TOOL 5 : Extraire les animations ───
@tool("extract_animations")
def extract_animations(html):
"""Détecte les animations CSS."""
if not html:
return {}
return {
"keyframes": len(re.findall(r'@keyframes', html, re.I)),
"transitions": len(re.findall(r'transition:', html, re.I)),
"transforms": len(re.findall(r'transform:', html, re.I)),
"animations": len(re.findall(r'animation:', html, re.I)),
"cubic_bezier": len(re.findall(r'cubic-bezier', html, re.I)),
}


# ─── TOOL 6 : Détecter le framework ───
@tool("detect_framework")
def detect_framework(html):
"""Détecte le framework utilisé (React, Vue, etc.)."""
if not html:
return []
frameworks = []
checks = {
"React": ["react", "_react", "react-dom", "__REACT"],
"Vue": ["vue.js", "vue.min.js", "data-v-", "__vue__"],
"Angular": ["ng-version", "angular.js", "ng-app"],
"Svelte": ["svelte", "svelte-"],
"Next.js": ["__next", "_next/static"],
"Nuxt": ["__nuxt", "_nuxt/"],
"Astro": ["astro-", "data-astro"],
"Tailwind": ["tailwind", "tw-"],
"Bootstrap": ["bootstrap"],
"jQuery": ["jquery"],
}
for nom, signes in checks.items():
for s in signes:
if s.lower() in html.lower():
frameworks.append(nom); break
return frameworks


# ─── TOOL 7 : Extraire les assets ───
@tool("extract_assets")
def extract_assets(html, base_url):
"""Liste les images, CSS, scripts de la page."""
if not html:
return {}
from urllib.parse import urljoin
assets = {"images": [], "css": [], "js": [], "fonts": []}
for m in re.findall(r'<img[^>]+src=["\']([^"\']+)', html, re.I):
assets["images"].append(urljoin(base_url, m))
for m in re.findall(r'<link[^>]+href=["\']([^"\']+\.css[^"\']*)', html, re.I):
assets["css"].append(urljoin(base_url, m))
for m in re.findall(r'<script[^>]+src=["\']([^"\']+)', html, re.I):
assets["js"].append(urljoin(base_url, m))
for m in re.findall(r'url\(["\']?([^"\')]+\.(woff2?|ttf|otf))', html, re.I):
assets["fonts"].append(urljoin(base_url, m[0]))
for k in assets:
assets[k] = list(set(assets[k]))[:30]
return assets


# ─── TOOL 8 : Générer palette ───
@tool("generate_palette")
def generate_palette(colors, n=5):
"""Génère une palette à partir des couleurs extraites."""
if not colors:
return ["#000000", "#ffffff", "#c8a45c", "#ff6ec7", "#00d4ff"][:n]
return colors[:n]


# ─── TOOL 9 : Analyser responsive ───
@tool("analyze_responsive")
def analyze_responsive(html):
"""Détecte les media queries."""
if not html:
return {}
mq = re.findall(r'@media[^{]+', html, re.I)
breakpoints = set()
for m in mq:
for px in re.findall(r'(\d+)px', m):
breakpoints.add(int(px))
return {
"nb_media_queries": len(mq),
"breakpoints": sorted(breakpoints),
}


# ─── TOOL 10 : Extraire textes ───
@tool("extract_texts")
def extract_texts(html):
"""Extrait les textes principaux (h1, h2, p)."""
if not html:
return {}
def clean(s):
return re.sub(r'<[^>]+>', '', s).strip()[:120]
return {
"h1": [clean(h) for h in re.findall(r'<h1[^>]*>(.*?)</h1>', html, re.I | re.S)][:10],
"h2": [clean(h) for h in re.findall(r'<h2[^>]*>(.*?)</h2>', html, re.I | re.S)][:15],
"paragraphes": [clean(p) for p in re.findall(r'<p[^>]*>(.*?)</p>', html, re.I | re.S)][:20],
}


# ─── TOOL 11 : Hash SHA256 ───
@tool("hash_sha256")
def hash_sha256(txt):
return hashlib.sha256(str(txt).encode()).hexdigest()


# ─── TOOL 12 : Token sécurisé ───
@tool("gen_token")
def gen_token(n=32):
return secrets.token_urlsafe(n)


# ─── TOOL 13 : Générer UUID ───
@tool("gen_uuid")
def gen_uuid():
import uuid
return str(uuid.uuid4())


# ─── TOOL 14 : Tester port ───
@tool("test_port")
def test_port(host, port, timeout=3):
try:
s = socket.create_connection((host, int(port)), timeout=timeout)
s.close()
return True
except Exception:
return False


# ─── TOOL 15 : Scanner ports ───
@tool("scan_ports")
def scan_ports(host, ports=None):
if ports is None:
ports = [21, 22, 23, 25, 53, 80, 110, 143, 443, 445, 3306, 5432, 8080, 8443, 9000, 9001, 9002, 9003, 9004, 9019]
resultats = {}
for p in ports:
resultats[p] = test_port(host, p, timeout=1)
return resultats


# ─── TOOL 16 : Whoami réseau ───
@tool("public_ip")
def public_ip():
try:
req = urllib.request.Request("https://api.ipify.org?format=json", headers=HEADERS)
with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
return json.loads(r.read())
except Exception as e:
return {"erreur": str(e)}


# ─── TOOL 17 : DNS lookup ───
@tool("dns_lookup")
def dns_lookup(host):
try:
return {"host": host, "ip": socket.gethostbyname(host)}
except Exception as e:
return {"host": host, "erreur": str(e)}


# ─── TOOL 18 : HTTP status ───
@tool("http_status")
def http_status(url):
try:
req = urllib.request.Request(url, headers=HEADERS, method="HEAD")
with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
return {"url": url, "code": r.status, "headers": dict(r.headers)}
except urllib.error.HTTPError as e:
return {"url": url, "code": e.code}
except Exception as e:
return {"url": url, "erreur": str(e)}


# ─── TOOL 19 : Screenshot metadata ───
@tool("page_metadata")
def page_metadata(url):
"""Récupère toutes les métadonnées d'une page."""
html, final = download_html(url)
if not html:
return {"erreur": final}
return {
"url_finale": final,
"meta": analyze_html(html),
"couleurs": extract_colors(html),
"fonts": extract_fonts(html),
"animations": extract_animations(html),
"framework": detect_framework(html),
"responsive": analyze_responsive(html),
"textes": extract_texts(html),
}


# ─── TOOL 20 : Forge UI ───
@tool("forge_ui")
def forge_ui(config):
"""Génère un HTML/CSS/JS à partir d'une config."""
nom = config.get("nom", "Nexus UI")
couleur = config.get("couleur", "#c8a45c")
return f"""<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{nom}</title>
<style>
:root {{ --primaire: {couleur}; --fond: #0a0014; }}
body {{ background: var(--fond); color: white; font-family: -apple-system, system-ui; margin:0; padding:40px; }}
h1 {{ color: var(--primaire); font-size: 48px; }}
.card {{ background: rgba(200,164,92,0.1); border: 1px solid var(--primaire); border-radius: 16px; padding: 24px; }}
</style>
</head>
<body>
<h1>{nom}</h1>
<div class="card">Forge par Nexus Designer</div>
</body>
</html>"""



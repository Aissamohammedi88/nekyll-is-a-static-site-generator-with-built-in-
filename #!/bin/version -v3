# Couleurs terminal
V = '\033[92m'; J = '\033[93m'; R = '\033[91]'; B = '\033[94m'; C = '\033[96m'; M = '\033[95m'; N = '\033[0m'
def ok(m): print(f"{V}✅{N} {m}")
def no(m): print(f"{R}❌{N} {m}")
def warn(m): print(f"{J}⚠️ {N} {m}")
def info(m): print(f"{B}ℹ️ {N} {m}")
def sect(m): print(f"\n{C}{'═'*64}{N}\n{C} {m}{N}\n{C}{'═'*64}{N}\n")


# ═══════════════════════════════════════════════════════════════════
# TOOLS — Fonctions de scan
# ═══════════════════════════════════════════════════════════════════
TOOLS = {}

def tool(nom, desc):
def wrapper(fn):
TOOLS[nom] = {"fn": fn, "desc": desc}
return fn
return wrapper


# ─── TOOL 1 : IP locale ───
@tool("ip_locale", "Renvoie l'IP locale de la machine")
def t_ip_locale():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]
s.close()
return {"ip": ip, "hostname": socket.gethostname()}
except Exception as e:
return {"erreur": str(e)}


# ─── TOOL 2 : IP publique ───
@tool("ip_publique", "Renvoie l'IP publique")
def t_ip_publique():
try:
req = urllib.request.Request("https://api.ipify.org?format=json", headers=HEADERS)
with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
return json.loads(r.read())
except Exception as e:
try:
req = urllib.request.Request("http://ip-api.com/json", headers=HEADERS)
with urllib.request.urlopen(req, timeout=10) as r:
return json.loads(r.read())
except Exception:
return {"erreur": str(e)}


# ─── TOOL 3 : Ping (TCP) ───
@tool("ping", "Test de connectivité TCP sur un port")
def t_ping(host, port=80, timeout=3):
debut = time.time()
try:
s = socket.create_connection((host, int(port)), timeout=timeout)
s.close()
duree = (time.time() - debut) * 1000
return {"host": host, "port": port, "ok": True, "ms": round(duree, 2)}
except Exception as e:
return {"host": host, "port": port, "ok": False, "erreur": str(e)[:80]}


# ─── TOOL 4 : Port scan ───
@tool("port_scan", "Scan de ports TCP sur une cible")
def t_port_scan(host, ports=None):
if ports is None:
ports = [21, 22, 23, 25, 53, 80, 110, 143, 443, 445, 993, 995,
3306, 3389, 5432, 5900, 6379, 8080, 8443, 9000, 9001,
9002, 9003, 9004, 9005, 9006, 9007, 9008, 9009, 9010, 9011]
resultats = {}
def check(p):
try:
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(0.8)
r = s.connect_ex((host, p))
s.close()
return p, (r == 0)
except Exception:
return p, False

with ThreadPoolExecutor(max_workers=50) as ex:
futures = [ex.submit(check, p) for p in ports]
for f in as_completed(futures):
p, ouvert = f.result()
resultats[p] = ouvert

return {
"host": host,
"total": len(ports),
"ouverts": [p for p, o in resultats.items() if o],
"fermes": [p for p, o in resultats.items() if not o],
}


# ─── TOOL 5 : DNS lookup ───
@tool("dns_lookup", "Résolution DNS d'un nom de domaine")
def t_dns_lookup(host):
try:
ip = socket.gethostbyname(host)
try:
infos = socket.gethostbyname_ex(host)
aliases = infos[1]
ips = infos[2]
except Exception:
aliases = []
ips = [ip]
return {"host": host, "ip": ip, "aliases": aliases, "toutes_ips": ips}
except Exception as e:
return {"host": host, "erreur": str(e)}


# ─── TOOL 6 : DNS reverse ───
@tool("dns_reverse", "Reverse DNS (IP vers hostname)")
def t_dns_reverse(ip):
try:
host = socket.gethostbyaddr(ip)
return {"ip": ip, "hostname": host[0], "aliases": host[1]}
except Exception as e:
return {"ip": ip, "erreur": str(e)}


# ─── TOOL 7 : HTTP status ───
@tool("http_status", "Vérifie le code HTTP d'une URL")
def t_http_status(url):
try:
req = urllib.request.Request(url, headers=HEADERS, method="HEAD")
with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
return {
"url": url,
"code": r.status,
"serveur": r.headers.get("Server", "?"),
"type": r.headers.get("Content-Type", "?"),
"taille": r.headers.get("Content-Length", "?"),
}
except urllib.error.HTTPError as e:
return {"url": url, "code": e.code, "raison": str(e)[:80]}
except Exception as e:
return {"url": url, "erreur": str(e)[:80]}


# ─── TOOL 8 : Latency test ───
@tool("latency", "Test de latence (moyenne sur N essais)")
def t_latency(host, port=443, n=5):
temps = []
for _ in range(n):
debut = time.time()
try:
s = socket.create_connection((host, int(port)), timeout=3)
s.close()
temps.append((time.time() - debut) * 1000)
except Exception:
pass
if not temps:
return {"host": host, "erreur": "Aucun test réussi"}
return {
"host": host,
"port": port,
"essais": n,
"reussis": len(temps),
"min_ms": round(min(temps), 2),
"max_ms": round(max(temps), 2),
"moy_ms": round(sum(temps) / len(temps), 2),
}


# ─── TOOL 9 : Scan réseau local ───
@tool("scan_lan", "Détecte les appareils sur le réseau local")
def t_scan_lan(subnet=None):
if not subnet:
ip = t_ip_locale().get("ip", "192.168.1.1")
parts = ip.split(".")
subnet = f"{parts[0]}.{parts[1]}.{parts[2]}"

def ping_ip(i):
ip = f"{subnet}.{i}"
try:
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(0.3)
r = s.connect_ex((ip, 80))
s.close()
if r == 0:
return ip
except Exception:
pass
try:
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(0.3)
r = s.connect_ex((ip, 443))
s.close()
if r == 0:
return ip
except Exception:
pass
try:
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(0.3)
r = s.connect_ex((ip, 22))
s.close()
if r == 0:
return ip
except Exception:
pass
return None

actifs = []
with ThreadPoolExecutor(max_workers=100) as ex:
futures = [ex.submit(ping_ip, i) for i in range(1, 255)]
for f in as_completed(futures):
r = f.result()
if r:
actifs.append(r)

return {
"subnet": f"{subnet}.0/24",
"appareils_detectes": sorted(actifs),
"total": len(actifs),
}


# ─── TOOL 10 : Whois basique (via API) ───
@tool("whois", "Info basique sur un domaine (via API)")
def t_whois(domaine):
try:
url = f"https://rdap.org/domain/{domaine}"
req = urllib.request.Request(url, headers=HEADERS)
with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
data = json.loads(r.read())
events = data.get("events", [])
dates = {}
for e in events:
dates[e.get("eventAction", "?")] = e.get("eventDate", "?")
noms = []
for e in data.get("entities", []):
for v in e.get("vcardArray", [[]])[1] if isinstance(e.get("vcardArray"), list) else []:
if v and v[0] == "fn":
noms.append(v[3])
return {"domaine": domaine, "dates": dates, "contacts": noms}
except Exception as e:
return {"domaine": domaine, "erreur": str(e)[:100]}


# ─── TOOL 11 : Test HTTP headers sécurité ───
@tool("security_headers", "Vérifie les headers de sécurité d'une URL")
def t_security_headers(url):
try:
req = urllib.request.Request(url, headers=HEADERS, method="HEAD")
with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
headers = dict(r.headers)
securite = [
"Strict-Transport-Security",
"Content-Security-Policy",
"X-Frame-Options",
"X-Content-Type-Options",
"Referrer-Policy",
"Permissions-Policy",
]
resultat = {}
for h in securite:
resultat[h] = headers.get(h, "❌ ABSENT")
return {"url": url, "headers": resultat, "tous": headers}
except Exception as e:
return {"url": url, "erreur": str(e)[:80]}


# ─── TOOL 12 : Traceroute simple ───
@tool("traceroute", "Trace le chemin réseau vers une cible")
def t_traceroute(host, max_hops=10):
hops = []
try:
ip = socket.gethostbyname(host)
except Exception as e:
return {"erreur": str(e)}

for ttl in range(1, max_hops + 1):
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
s.setsockopt(socket.SOL_IP, socket.IP_TTL, ttl)
s.settimeout(1)
s.sendto(b"", (ip, 33434))
try:
_, addr = s.recvfrom(512)
hops.append({"ttl": ttl, "ip": addr[0]})
except socket.timeout:
hops.append({"ttl": ttl, "ip": "*"})
s.close()
except Exception:
break

return {"host": host, "ip": ip, "hops": hops}


# ─── TOOL 13 : SSL certificate info ───
@tool("ssl_info", "Infos sur le certificat SSL d'un domaine")
def t_ssl_info(host, port=443):
try:
s = socket.create_connection((host, port), timeout=5)
ctx_ssl = ssl.create_default_context()
ctx_ssl.check_hostname = False
ctx_ssl.verify_mode = ssl.CERT_NONE
ss = ctx_ssl.wrap_socket(s, server_hostname=host)
cert = ss.getpeercert()
ss.close()
return {
"host": host,
"sujet": dict(x[0] for x in cert.get("subject", [])),
"emetteur": dict(x[0] for x in cert.get("issuer", [])),
"valide_du": cert.get("notBefore", "?"),
"valide_au": cert.get("notAfter", "?"),
"version": cert.get("version", "?"),
}
except Exception as e:
return {"host": host, "erreur": str(e)[:100]}


# ─── TOOL 14 : Bannière de service ───
@tool("banner", "Récupère la bannière d'un service")
def t_banner(host, port):
try:
s = socket.create_connection((host, int(port)), timeout=5)
s.settimeout(3)
try:
s.send(b"\r\n")
data = s.recv(1024)
s.close()
return {"host": host, "port": port, "banniere": data.decode("utf-8", errors="ignore")[:200]}
except Exception:
s.close()
return {"host": host, "port": port, "banniere": ""}
except Exception as e:
return {"host": host, "port": port, "erreur": str(e)[:80]}



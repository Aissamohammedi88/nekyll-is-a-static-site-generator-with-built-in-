def main():
print(f"""
{M}╔════════════════════════════════════════════════════════════════╗
║ 🧬 NEXUS MODEL 01 — SCANNER RÉSEAU ║
║ CreWos Sybot — Étape 1/10 ║
╚════════════════════════════════════════════════════════════════╝{N}
""")
info(f"Chemin : {BASE}/modele_01.py")
info(f"Tools : {len(TOOLS)}")
print()
for nom, info_t in TOOLS.items():
print(f" 🔧 {nom.ljust(18)} — {info_t['desc']}")
print()
ok(f"Serveur : http://192.168.1.42:{PORT}/")
info(f"API : http://192.168.1.42:{PORT}/api/tools")
print()
warn("Ctrl+C pour arrêter")

try:
with Server((HOST, PORT), Handler) as srv:
srv.serve_forever()
except KeyboardInterrupt:
print("\n👋 Arrêté.")
except OSError as e:
no(f"Port {PORT} : {e}")


if __name__ == "__main__":
main()
